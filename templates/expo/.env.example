# Copy to .env.local (gitignored). Values for cloud builds go into EAS environment variables instead.
# EXPO_PUBLIC_* values are compiled into the app and readable by anyone: put only public keys here.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=development
EXPO_PUBLIC_PURCHASES_IOS_API_KEY=
# Build-time only (source map upload); a secret in EAS, never EXPO_PUBLIC_
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
